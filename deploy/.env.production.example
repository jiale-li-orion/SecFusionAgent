SECFUSION_POSTGRES_PASSWORD=replace-with-a-long-random-password
SECFUSION_HTTP_PORT=80
# Bind Product Web only to the TLS terminator's reachable interface.
SECFUSION_HTTP_BIND_ADDRESS=127.0.0.1
# Public HTTPS origin when a TLS-terminating reverse proxy fronts Product Web.
# Use a JSON list of exact origins, including a non-default port if present.
SECFUSION_AUTH_ALLOWED_ORIGINS=[]
SECFUSION_AUTH_SESSION_TTL_SECONDS=604800
SECFUSION_NVD_API_KEY=
SECFUSION_GITHUB_TOKEN=
SECFUSION_SHODAN_API_KEY=
SECFUSION_X_BEARER_TOKEN=
SECFUSION_CENSYS_PAT=
SECFUSION_CENSYS_ORGANIZATION_ID=
SECFUSION_FOFA_API_KEY=
SECFUSION_ZOOMEYE_API_KEY=
SECFUSION_SEMANTIC_SCHOLAR_API_KEY=
SECFUSION_MODEL_BASE_URL=
SECFUSION_MODEL_API_KEY=
SECFUSION_MODEL_NAME=
