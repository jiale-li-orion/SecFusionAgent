SECFUSION_ENVIRONMENT=dev
SECFUSION_LOG_LEVEL=INFO

SECFUSION_DATABASE_URL=postgresql+asyncpg://secfusion:secfusion@localhost:5432/secfusion
SECFUSION_REDIS_BROKER_URL=redis://localhost:6379/0
SECFUSION_REDIS_HOT_CACHE_URL=redis://localhost:6380/0
SECFUSION_HOT_CACHE_TTL_SECONDS=2592000
SECFUSION_INCIDENT_SIGNAL_TTL_SECONDS=604800
SECFUSION_SOURCE_REGISTRY_PATH=config/sources
SECFUSION_COLLECTION_RUN_TIMEOUT_SECONDS=900
SECFUSION_SCHEDULER_TICK_SECONDS=5

SECFUSION_S3_ENDPOINT_URL=http://localhost:9000
SECFUSION_S3_ACCESS_KEY=secfusion
SECFUSION_S3_SECRET_KEY=change-me
SECFUSION_S3_BUCKET=secfusion-evidence
SECFUSION_S3_REGION=us-east-1

SECFUSION_NVD_API_KEY=
SECFUSION_GITHUB_TOKEN=

SECFUSION_SHODAN_API_KEY=
SECFUSION_CENSYS_PAT=
SECFUSION_CENSYS_ORGANIZATION_ID=
SECFUSION_FOFA_API_KEY=
SECFUSION_ZOOMEYE_API_KEY=
SECFUSION_SEMANTIC_SCHOLAR_API_KEY=

# Optional OpenAI-compatible M3 semantic / dense indexing provider.
# Example compatible endpoints include hosted or local services that expose
# /chat/completions and /embeddings under the configured base URL.
SECFUSION_MODEL_BASE_URL=
SECFUSION_MODEL_API_KEY=
SECFUSION_MODEL_NAME=
SECFUSION_EMBEDDING_MODEL_NAME=
SECFUSION_EMBEDDING_DIMENSIONS=
SECFUSION_MODEL_TIMEOUT_SECONDS=60

# Optional X API v2 access for researcher/on-chain incident signals.
SECFUSION_X_BEARER_TOKEN=
