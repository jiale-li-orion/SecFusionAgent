{
  "source_id": "huggingface-security",
  "adapter_type": "html_index",
  "source_class": "vendor_security_material",
  "authority_scope": [
    "agent_security",
    "model_supply_chain",
    "incident_response"
  ],
  "source_role": "primary",
  "source_family": "huggingface",
  "access_mode": "html_index",
  "update_semantics": "mutable_research_article",
  "discovery_method": {
    "index_url": "https://huggingface.co/blog",
    "link_selector": "a[href*='/blog/']",
    "allowed_hosts": [
      "huggingface.co"
    ],
    "max_items": 40
  },
  "time_semantics": {
    "observed_at": "collector_clock",
    "published_at": "article_metadata_when_explicit"
  },
  "identity_semantics": {
    "external_object_id": "canonical article URL"
  },
  "rate_limit_policy": {
    "provider": "huggingface",
    "polite_interval_seconds": 3
  },
  "access_rights": {
    "classification": "public"
  },
  "retention_mode": "durable_managed",
  "schedule_policy": {
    "enabled": true,
    "interval_seconds": 21600
  },
  "schema_version": "1"
}
