{
  "source_id": "censys-assets",
  "adapter_type": "censys_asset",
  "source_class": "internet_asset_intelligence",
  "authority_scope": [
    "host_observation",
    "service_port",
    "protocol",
    "software_fingerprint",
    "asn_location",
    "observation_time"
  ],
  "source_role": "telemetry",
  "source_family": "censys",
  "access_mode": "https_api",
  "update_semantics": "on_demand_observation",
  "discovery_method": {
    "base_url": "https://api.platform.censys.io/v3/global/search/query"
  },
  "time_semantics": {
    "observed_at": "collector_clock"
  },
  "identity_semantics": {
    "external_object_id": "ip + port + transport"
  },
  "auth_ref": "SECFUSION_CENSYS_PAT",
  "rate_limit_policy": {
    "provider": "censys"
  },
  "access_rights": {
    "classification": "authorized_api"
  },
  "retention_mode": "time_bounded",
  "schedule_policy": {
    "enabled": false
  },
  "schema_version": "1"
}
