{
  "source_id": "chainalysis-research",
  "adapter_type": "html_index",
  "source_class": "incident_forensic_research",
  "authority_scope": ["fund_flow_analysis", "crypto_crime_pattern", "incident_context", "forensic_analysis"],
  "source_role": "forensic",
  "source_family": "chainalysis",
  "access_mode": "html_index",
  "update_semantics": "mutable_research_article",
  "discovery_method": {
    "index_url": "https://www.chainalysis.com/blog/",
    "link_selector": "a.archive__post[href*='/blog/']",
    "allowed_hosts": ["www.chainalysis.com", "chainalysis.com"],
    "max_items": 30
  },
  "time_semantics": {"updated_at": "http_last_modified_when_available"},
  "identity_semantics": {
    "external_object_id": "canonical_article_url",
    "external_revision": "etag_or_last_modified"
  },
  "rate_limit_policy": {"provider": "chainalysis"},
  "access_rights": {"classification": "public"},
  "retention_mode": "durable_managed",
  "schedule_policy": {"enabled": true, "interval_seconds": 21600},
  "schema_version": "1"
}
