{
  "source_id": "meta-ai-safety",
  "adapter_type": "html_index",
  "source_class": "vendor_security_material",
  "authority_scope": [
    "model_safety",
    "cybersecurity_evaluation",
    "responsible_ai",
    "security_tooling"
  ],
  "source_role": "primary",
  "source_family": "meta-ai",
  "access_mode": "html_index",
  "update_semantics": "mutable_technical_article",
  "discovery_method": {
    "index_url": "https://ai.meta.com/blog/",
    "link_selector": "a[href^=\"/blog/\"]",
    "allowed_hosts": [
      "ai.meta.com"
    ],
    "max_items": 25
  },
  "time_semantics": {
    "updated_at": "http_last_modified_when_available"
  },
  "identity_semantics": {
    "external_object_id": "canonical_article_url",
    "external_revision": "etag_or_last_modified"
  },
  "rate_limit_policy": {
    "provider": "meta-ai"
  },
  "access_rights": {
    "classification": "public"
  },
  "retention_mode": "durable_managed",
  "schedule_policy": {
    "enabled": true,
    "interval_seconds": 21600
  },
  "schema_version": "1"
}
