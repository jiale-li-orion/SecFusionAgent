{
  "source_id": "trailofbits-research",
  "adapter_type": "html_index",
  "source_class": "independent_security_research",
  "authority_scope": ["independent_reproduction", "attack_path", "technical_analysis"],
  "source_role": "forensic",
  "source_family": "trailofbits",
  "access_mode": "html_index",
  "update_semantics": "mutable_article",
  "discovery_method": {
    "index_url": "https://blog.trailofbits.com/",
    "item_selector": "article.list__item.post",
    "link_selector": "h2 a[href]",
    "title_selector": "h2",
    "allowed_hosts": ["blog.trailofbits.com"],
    "max_items": 25
  },
  "time_semantics": {
    "updated_at": "http_last_modified_when_available"
  },
  "identity_semantics": {
    "external_object_id": "canonical_article_url",
    "external_revision": "etag_or_last_modified"
  },
  "rate_limit_policy": {
    "provider": "trailofbits"
  },
  "access_rights": {
    "classification": "public"
  },
  "retention_mode": "durable_managed",
  "schedule_policy": {
    "enabled": true,
    "interval_seconds": 21600
  },
  "schema_version": "1"
}
