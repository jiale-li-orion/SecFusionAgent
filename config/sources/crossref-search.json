    "external_object_id": "DOI"
  },
  "rate_limit_policy": {
    "provider": "crossref"
  },
  "access_rights": {
    "classification": "public-metadata"
  },
  "retention_mode": "time_bounded",
  "schedule_policy": {
    "enabled": false
  },
  "schema_version": "1"
