{
  "source_id": "wiz-research",
  "adapter_type": "html_index",
  "source_class": "independent_security_research",
  "authority_scope": [
    "independent_reproduction",
    "cloud_ai_security",
    "attack_path",
    "technical_analysis"
  ],
  "source_role": "forensic",
  "source_family": "wiz-research",
  "access_mode": "html_index",
  "update_semantics": "mutable_research_article",
  "discovery_method": {
    "index_url": "https://www.wiz.io/research",
    "link_selector": "a[href^='/blog/']",
    "allowed_hosts": [
      "www.wiz.io",
      "wiz.io"
    ],
    "max_items": 25
  },
  "time_semantics": {
    "updated_at": "http_last_modified_when_available"
  },
  "identity_semantics": {
    "external_object_id": "canonical_article_url",
    "external_revision": "etag_or_last_modified"
  },
  "rate_limit_policy": {
    "provider": "wiz"
  },
  "access_rights": {
    "classification": "public"
  },
  "retention_mode": "durable_managed",
  "schedule_policy": {
    "enabled": true,
    "interval_seconds": 21600
  },
  "schema_version": "1"
}
