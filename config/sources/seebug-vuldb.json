{
  "source_id": "seebug-vuldb",
  "adapter_type": "html_index",
  "source_class": "independent_security_research",
  "authority_scope": ["poc_reference", "community_analysis", "chinese_vulnerability_context"],
  "source_role": "reference",
  "source_family": "seebug",
  "access_mode": "html_index",
  "update_semantics": "mutable_vulnerability_article",
  "discovery_method": {
    "index_url": "https://www.seebug.org/vuldb/vulnerabilities",
    "link_selector": "a[href*='/vuldb/ssvid-']",
    "allowed_hosts": ["www.seebug.org", "seebug.org"],
    "max_items": 20
  },
  "time_semantics": {"observed_at": "collector_clock"},
  "identity_semantics": {"external_object_id": "canonical Seebug vulnerability URL"},
  "rate_limit_policy": {"provider": "seebug"},
  "access_rights": {"classification": "public"},
  "retention_mode": "durable_managed",
  "schedule_policy": {"enabled": false},
  "schema_version": "1"
}
