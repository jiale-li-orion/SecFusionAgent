{
  "source_id": "microsoft-security-ai",
  "adapter_type": "html_index",
  "source_class": "vendor_security_material",
  "authority_scope": [
    "agent_security",
    "platform_security",
    "security_research",
    "vendor_mitigation"
  ],
  "source_role": "primary",
  "source_family": "microsoft-security",
  "access_mode": "html_index",
  "update_semantics": "mutable_security_article",
  "discovery_method": {
    "index_url": "https://www.microsoft.com/en-us/security/blog/topic/ai-and-machine-learning/",
    "link_selector": "a[href*='/security/blog/202']",
    "allowed_hosts": [
      "www.microsoft.com",
      "microsoft.com"
    ],
    "max_items": 25
  },
  "time_semantics": {
    "updated_at": "http_last_modified_when_available"
  },
  "identity_semantics": {
    "external_object_id": "canonical_article_url",
    "external_revision": "etag_or_last_modified"
  },
  "rate_limit_policy": {
    "provider": "microsoft"
  },
  "access_rights": {
    "classification": "public"
  },
  "retention_mode": "durable_managed",
  "schedule_policy": {
    "enabled": true,
    "interval_seconds": 21600
  },
  "schema_version": "1"
}
