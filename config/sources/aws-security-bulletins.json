{
  "source_id": "aws-security-bulletins",
  "adapter_type": "html_index",
  "source_class": "vendor_security_material",
  "authority_scope": ["aws_product_impact", "vendor_fix", "vendor_mitigation"],
  "source_role": "primary",
  "source_family": "aws-security",
  "access_mode": "html_index",
  "update_semantics": "mutable_security_bulletin",
  "discovery_method": {
    "index_url": "https://aws.amazon.com/security/security-bulletins/",
    "link_selector": "a[href^='/security/security-bulletins/20']",
    "allowed_hosts": ["aws.amazon.com"],
    "max_items": 25
  },
  "time_semantics": {
    "updated_at": "http_last_modified_when_available"
  },
  "identity_semantics": {
    "external_object_id": "canonical_bulletin_url",
    "external_revision": "etag_or_last_modified"
  },
  "rate_limit_policy": {
    "provider": "aws"
  },
  "access_rights": {
    "classification": "public"
  },
  "retention_mode": "durable_managed",
  "schedule_policy": {
    "enabled": true,
    "interval_seconds": 21600
  },
  "schema_version": "1"
}
